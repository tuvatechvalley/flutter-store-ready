# Normalize line endings: scripts must keep LF on Windows checkouts too.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.jks binary
*.keystore binary
*.ttf binary
*.otf binary
